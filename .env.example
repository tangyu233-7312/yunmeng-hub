# ============================================================
#  异构大模型交互式叙事引擎 —— 环境变量模板
# ------------------------------------------------------------
#  用法：复制本文件为 .env 后填写真实值
#      Copy-Item .env.example .env
#  ！.env 已被 .gitignore 忽略，绝不提交到仓库 ！
#
#  ★ 所有键名都必须带 HNE_ 前缀 ★
#  HNE = Hetero Narrative Engine。HOST / PORT / DEBUG / DEFAULT_LLM_BASE_URL
#  这类通用名极易与系统里其它工具的环境变量撞车；而环境变量优先级高于 .env，
#  一旦撞车就会「静默覆盖」本文件里的正确配置——不报错，只是配置莫名不生效。
#  加前缀后只有 HNE_XXX 会被读取，彻底规避这个问题。
# ============================================================

#  ============================================================
#  ★ 桌面版说明（desktop/）★
#  装出来的桌面版**不需要你配任何东西**：数据默认存成用户数据目录下的
#  一个 SQLite 文件（%APPDATA%\云梦枢\data\app.sqlite3），
#  数据表在后端启动时自动创建、两个密钥在首次运行时自动生成并保存到
#  %APPDATA%\云梦枢\config\.secrets.env。想改成 MySQL 就在「首次设置」页里
#  把「存储方式」切成 MySQL（或直接改那份 config\.env）。
#  开发态（在仓库里 `npm start`）仍优先用**仓库根这份 .env**（为开发方便）。
#  无论哪种形态：**这个文件都不会被打进安装包**。
#  ============================================================

# ---------------------- 应用基础 ----------------------
HNE_APP_NAME=HeteroNarrativeEngine
HNE_APP_ENV=development
HNE_DEBUG=true
HNE_HOST=127.0.0.1
HNE_PORT=8000
HNE_API_V1_PREFIX=/api/v1

# 允许跨域的前端来源（后续 HTML/CSS/JS 与 Electron 打包后使用）
# JSON 数组格式
HNE_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000","file://"]

# ---------------------- 安全 / JWT ----------------------
# ★ 桌面版可以留空：后端首次运行会**自动生成**并保存到
#   <数据目录>/config/.secrets.env（见 app/db/bootstrap.py）。
#   想自己掌控就填，生成命令：
#       python -c "import secrets; print(secrets.token_urlsafe(48))"
HNE_SECRET_KEY=CHANGE_ME_GENERATE_A_RANDOM_SECRET
HNE_JWT_ALGORITHM=HS256
HNE_ACCESS_TOKEN_EXPIRE_MINUTES=60
HNE_REFRESH_TOKEN_EXPIRE_DAYS=7

# 密码哈希强度（bcrypt cost，10~14，越大越慢越安全）
HNE_BCRYPT_ROUNDS=12

# 用于加密"用户自配的 LLM API Key"（Fernet 对称密钥，必须为 44 位 base64）
# ★ 同样可以留空（后端会自动生成）。★ 一旦用它存过 Key 就**别改**这个值：
#   改了之后那些密文就再也解不开了。
# 生成命令： python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
HNE_API_KEY_ENCRYPTION_KEY=CHANGE_ME_FERNET_KEY

# ---------------------- 数据存放位置 ----------------------
# 全部可变数据（SQLite 文件、向量库、日志）的相对路径都以它为基准。
# 留空 = 用项目根目录（开发态行为）。桌面版会把这一项设成用户数据目录。
# HNE_DATA_DIR=

# ---------------------- 数据库后端（二选一）---------------------
#  sqlite（默认）：数据存成**一个文件**，不需要安装任何数据库服务，装完即用。
#                  表结构由后端启动时自动创建；适合单机单用户。
#  mysql         ：连一个已有的 MySQL 8 实例；多人共用/已有 MySQL 时用它。
# ★ 单机桌面应用推荐 sqlite；两种后端的测试都在 CI 里跑（见 tests/test_db_sqlite.py）。
HNE_DB_BACKEND=sqlite

# SQLite 数据文件（留空 = <数据根目录>/data/app.sqlite3）
# HNE_SQLITE_PATH=
# SQLite 写锁等待时间（毫秒）。设 0 会让并发写直接报 "database is locked"
HNE_SQLITE_BUSY_TIMEOUT_MS=10000

# ---------------------- MySQL（HNE_DB_BACKEND=mysql 时才需要）---------------------
HNE_MYSQL_HOST=127.0.0.1
HNE_MYSQL_PORT=3306
HNE_MYSQL_USER=narrative_app
HNE_MYSQL_PASSWORD=CHANGE_ME
HNE_MYSQL_DB=narrative_engine
HNE_MYSQL_CHARSET=utf8mb4

# 连接池（SQLAlchemy QueuePool）—— 仅 MySQL 后端使用
HNE_DB_POOL_SIZE=10
HNE_DB_MAX_OVERFLOW=20
HNE_DB_POOL_TIMEOUT=30
HNE_DB_POOL_RECYCLE=3600
HNE_DB_ECHO=false

# ---------------------- ChromaDB 向量库 ----------------------
HNE_CHROMA_PERSIST_DIR=./data/chroma
HNE_CHROMA_COLLECTION_PREFIX=narrative

# 嵌入后端策略：
#   onnx_default = ChromaDB 内置 ONNX MiniLM（本地推理，免费，首次使用联网下载约 80MB）
#   api          = 调用自配服务的 /embeddings 接口（中文效果好，产生费用）
#                  ★ 这是本项目"异构"设计的延伸：不绑定任何嵌入模型厂商
HNE_EMBEDDING_BACKEND=onnx_default

# ---- onnx_default 后端参数（内置模型固定为 all-MiniLM-L6-v2 / 384 维）----
HNE_EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2
HNE_EMBEDDING_DIMENSION=384

# ---- api 后端参数（HNE_EMBEDDING_BACKEND=api 时才读取）----
# 维度填 0 = 首次调用自动探测（推荐，不同厂商维度不同：bge-m3=1024, text-embedding-3-small=1536）
HNE_EMBEDDING_API_DIMENSION=0
HNE_EMBEDDING_API_BASE_URL=
HNE_EMBEDDING_API_KEY=

# 一次请求最多嵌入多少条文本（API 后端分批用，避免请求体过大被拒）
HNE_EMBEDDING_BATCH_SIZE=64

# ---------------------- 默认 LLM（可选兜底） ----------------------
# 留空时：系统强制要求用户自行配置 Provider，不做任何兜底。
# 填写后可用于本地联调真实厂商 API（pytest 的 live 测试会读取这三项）。
HNE_DEFAULT_LLM_BASE_URL=
HNE_DEFAULT_LLM_API_KEY=
HNE_DEFAULT_LLM_MODEL=
# 默认模型的上下文窗口总容量（输入 + 输出），仅诊断接口使用
HNE_DEFAULT_LLM_CONTEXT_WINDOW=65536
HNE_LLM_REQUEST_TIMEOUT=120
HNE_LLM_MAX_RETRIES=3

# ---------------------- 日志 ----------------------
HNE_LOG_LEVEL=INFO
HNE_LOG_DIR=./data/logs
